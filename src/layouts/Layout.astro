---
import CountUp from "../React/CountUp.tsx";
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Portfolio</title>
    <meta
      name="description"
      content="Hameedcode - Software Engineer building interactive and seamless digital experiences with cutting-edge frontend development."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://hameedcode.com/" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Hameedcode | Software Engineer"
    />
    <meta
      property="og:description"
      content="Portfolio of Hameedcode, Software Engineer specializing in frontend and interactive experiences."
    />
    <meta
      property="og:image"
      content="https://hameedcode.com/og.image.png"
    />
    <meta property="og:url" content="https://hameedcode.com" />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Hameedcode Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Hameedcode",
        "alternateName": "Hameedcode",
        "url": "https://hameedcode.com",
        "image": "https://hameedcode.com/og.image.png",
        "sameAs": [
          "https://github.com/mhdhameed7/",
          "https://www.linkedin.com/in/mhd-hameed-2895a2342",
          "https://www.facebook.com/share/1HkoFszpC9/",
          "https://www.instagram.com/itzprincehameed"
        ],
        "jobTitle": "Software Engineer",
        "description": "Software Engineer building interactive and seamless digital experiences."
      }
    </script>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9">
    <!-- Preloader -->
    <div id="preloader" style="
      position: fixed; inset: 0; z-index: 9999;
      background: #000;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 20px;
      transition: opacity 0.6s ease, visibility 0.6s ease;
    ">
      <!-- Ambient glow -->
      <div style="position:absolute;top:30%;left:50%;transform:translate(-50%,-50%);width:400px;height:300px;background:radial-gradient(ellipse,rgba(100,80,160,0.25) 0%,transparent 70%);pointer-events:none;"></div>

      <!-- Icons row -->
      <div style="display:flex;gap:16px;margin-bottom:8px;" id="preloader-icons">
        <div style="width:48px;height:48px;border-radius:50%;border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;opacity:0;animation:preIconIn 0.5s ease forwards 0.2s;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="2"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
        </div>
        <div style="width:48px;height:48px;border-radius:50%;border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;opacity:0;animation:preIconIn 0.5s ease forwards 0.4s;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </div>
        <div style="width:48px;height:48px;border-radius:50%;border:1px solid rgba(255,255,255,0.15);background:rgba(255,255,255,0.05);display:flex;align-items:center;justify-content:center;opacity:0;animation:preIconIn 0.5s ease forwards 0.6s;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.7)" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </div>
      </div>

      <!-- Welcome text -->
      <div style="text-align:center;opacity:0;animation:preTextIn 0.6s ease forwards 0.8s;">
        <p style="color:rgba(255,255,255,0.7);font-size:1.1rem;font-weight:400;margin-bottom:4px;">Welcome to my</p>
        <h1 style="font-size:1.8rem;font-weight:700;background:linear-gradient(90deg,#fff 0%,#a476ff 50%,#fff 100%);-webkit-background-clip:text;background-clip:text;color:transparent;margin:0;">Portfolio Website</h1>
        <p style="color:rgba(255,255,255,0.35);font-size:0.85rem;margin-top:8px;">Creating Websites That Feel Alive.</p>
      </div>

      <!-- URL bar -->
      <div style="opacity:0;animation:preTextIn 0.6s ease forwards 1.1s;margin-top:4px;display:flex;flex-direction:column;align-items:center;gap:15px;">
        <div style="display:flex;align-items:center;gap:8px;border:1px solid rgba(255,255,255,0.15);border-radius:999px;padding:6px 18px;background:rgba(255,255,255,0.04);">
          <span style="color:rgba(255,255,255,0.5);font-size:0.78rem;letter-spacing:0.04em;">hameedcode.com</span>
          <span style="width:1px;height:14px;background:rgba(255,255,255,0.4);animation:blink 1s step-end infinite;"></span>
        </div>
        <div style="font-size:1.5rem; font-weight:bold; color:var(--sec); display:flex; align-items:center;">
          <CountUp client:load from={0} to={100} duration={1.5} separator="," direction="up" />
          <span style="margin-left:2px;">%</span>
        </div>
      </div>

      <!-- Progress bar -->
      <div style="position:absolute;bottom:0;left:0;right:0;height:2px;background:rgba(255,255,255,0.05);">
        <div id="preloader-bar" style="height:100%;width:0%;background:linear-gradient(90deg,#a476ff,#fff);border-radius:999px;transition:width 2s cubic-bezier(0.4,0,0.2,1);"></div>
      </div>
    </div>

    <style>
      @keyframes preIconIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes preTextIn {
        from { opacity: 0; transform: translateY(12px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes blink {
        0%, 100% { opacity: 1; } 50% { opacity: 0; }
      }
    </style>

    <script is:inline>
      const preloader = document.getElementById('preloader');
      const bar = document.getElementById('preloader-bar');
      // Start progress bar
      setTimeout(() => { if (bar) bar.style.width = '100%'; }, 100);
      // Hide preloader after animation completes
      setTimeout(() => {
        if (preloader) {
          preloader.style.opacity = '0';
          preloader.style.visibility = 'hidden';
          setTimeout(() => { preloader.remove(); }, 600);
        }
      }, 3800);
    </script>

    <slot />
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  /* Scrollbar styles */

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  /* Scrollbar styles for Firefox */
  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
