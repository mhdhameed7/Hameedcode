---
import LetterGlitch from "../React/LetterGlitch.tsx";
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import SplitText from "../React/SplitText.tsx";
import Threads from "../React/Threads.tsx";
---

<section class="text-[var(--white)] mt-12 md:mt-0 relative overflow-hidden" id="home" style="margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw;">
  <!-- Threads Animated Background -->
  <div class="absolute top-0 z-0" style="opacity: 0.4; pointer-events: none; height: 55%; width: 100vw; left: 50%; transform: translateX(-50%); margin-left: 0;">
    <Threads
      client:load
      color={[0.643, 0.463, 1.0]}
      amplitude={1.2}
      distance={0.3}
      enableMouseInteraction={true}
    />
  </div>
  <!-- Bottom fade overlay so threads don't bleed into next section -->
  <div class="absolute bottom-0 left-0 right-0 h-32 z-0 pointer-events-none" style="background: linear-gradient(to bottom, transparent, var(--bg, #0a0a0a));"></div>

  <div class="max-w-5xl mx-auto space-y-8 md:py-36 pb-14 relative z-10">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-10">
      <!-- Left: Text Content -->
      <div class="text-left space-y-4 flex-1">
        <SplitText
          client:load
          text="Hi, I'm Hameed"
          className="text-md md:text-lg text-blue-500 font-medium m-0 p-0"
          delay={50}
          duration={0.6}
          ease="power3.out"
          splitType="chars"
          from={{ opacity: 0, y: 10 }}
          to={{ opacity: 1, y: 0 }}
          threshold={0.1}
          textAlign="left"
        />
        <div
          class="flex flex-col space-y-4"
        >
          <h1
            class="text-[var(--white)] text-5xl md:text-6xl font-medium text-pretty leading-none"
          >
            Software <br /> Engineer
          </h1>
          <p class="text-md md:text-2xl text-[var(--white-icon)] max-w-lg">
            Turning ideas into modern digital products through code, creativity, and <span class="text-[var(--sec)] shiny-sec"
              >full-stack</span
            > development.
          </p>
        </div>
        <div class="flex flex-wrap justify-start gap-2 pt-3 md:pt-6">
          <a
            target="_blank"
            href="https://github.com/mhdhameed7/"
            aria-label="GitHub"
            class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-8"
            >
              <path
                d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
              ></path>
            </svg>
          </a>
          <a
            target="_blank"
            href="https://www.linkedin.com/in/mhd-hameed-2895a2342?utm_source=share_via&utm_content=profile&utm_medium=member_android"
            aria-label="LinkedIn"
            class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-8"
            >
              <path
                d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"
              ></path>
            </svg>
          </a>
          <a
            target="_blank"
            href="mailto:mhdhameedofficial@gmail.com"
            aria-label="Email"
            class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="2.1em"
              height="2.1em"
              viewBox="0 0 24 24"
            >
              <path
                fill="currentColor"
                d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"
              ></path>
            </svg>
          </a>
          <a
            target="_blank"
            href="https://www.facebook.com/share/1HkoFszpC9/"
            aria-label="Facebook"
            class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-8"
            >
              <path d="M14 13.5H16.5L17.5 9.5H14V7.5C14 6.47 14 5.5 16 5.5H17.5V2.14C17.174 2.097 15.943 2 14.643 2C11.928 2 10 3.657 10 6.7V9.5H7V13.5H10V22H14V13.5Z" />
            </svg>
          </a>
          <a
            target="_blank"
            href="https://www.instagram.com/itzprincehameed?stkn=MXhnM2x1ZjZlOWk4NQ=="
            aria-label="Instagram"
            class="text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-1 border-[var(--white-icon-tr)] p-3 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              class="size-8"
            >
              <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2zm-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25zM12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5zm0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: 3D Interactive Profile Card -->
      <div class="flex justify-center lg:justify-end flex-shrink-0">
        <div
          id="profile-card-3d"
          class="relative w-[300px] h-[420px] cursor-pointer select-none"
          style="perspective: 1000px;"
        >
          <div
            id="profile-card-inner"
            class="relative w-full h-full rounded-3xl overflow-hidden border border-[#ffffff18] bg-gradient-to-b from-[#1e1e2e] to-[#0f0f0f] shadow-2xl transition-transform duration-100 ease-out"
            style="transform-style: preserve-3d;"
          >
            <!-- Glow effect -->
            <div class="absolute inset-0 rounded-3xl" style="background: radial-gradient(ellipse at 50% 0%, rgba(164,118,255,0.18) 0%, transparent 70%); pointer-events:none; z-index:2;"></div>
            <!-- Photo -->
            <img
              src="/profile.png"
              alt="Hameed"
              class="w-full h-full object-cover object-center"
              style="transform: translateZ(20px);"
            />
          </div>
          <!-- Reflection glow -->
          <div class="absolute -bottom-6 left-1/2 -translate-x-1/2 w-4/5 h-8 rounded-full blur-xl bg-[var(--sec)] opacity-20"></div>
        </div>
      </div>
    </div>

    <LogoWall />

    <div class="flex flex-col lg:flex-row items-center gap-8">
      <SkillsList client:load />
      <div
        class="flex justify-center md:w-full md:h-[292px] size-[290px] pt-3 md:pt-9 md:ml-16"
      >
        <LetterGlitch
          client:load
          glitchColors={["#5e4491", "#A476FF", "#241a38"]}
          glitchSpeed={33}
          centerVignette={false}
          outerVignette={true}
          smooth={true}
        />
      </div>
    </div>
  </div>
</section>

<style is:global>
  .shiny-sec {
    background: linear-gradient(135deg, #a476ff 25%, #eee5ff 50%, #a476ff 75%);
    background-size: 400% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: shine 3s linear infinite;
  }

  @keyframes shine {
    0% {
      background-position: 100% 50%;
    }
    30%,
    70% {
      background-position: 0% 50%;
    }
  }
</style>

<script is:inline>
  const card3d = document.getElementById("profile-card-3d");
  const cardInner = document.getElementById("profile-card-inner");

  if (card3d && cardInner) {
    card3d.addEventListener("mousemove", (e) => {
      const rect = card3d.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const centerX = rect.width / 2;
      const centerY = rect.height / 2;
      const rotateX = ((y - centerY) / centerY) * -18;
      const rotateY = ((x - centerX) / centerX) * 18;
      cardInner.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.04,1.04,1.04)`;
      cardInner.style.boxShadow = `${-rotateY * 2}px ${rotateX * 2}px 40px rgba(164,118,255,0.25), 0 20px 60px rgba(0,0,0,0.5)`;
    });

    card3d.addEventListener("mouseleave", () => {
      cardInner.style.transform = "rotateX(0deg) rotateY(0deg) scale3d(1,1,1)";
      cardInner.style.boxShadow = "0 20px 60px rgba(0,0,0,0.5)";
    });
  }
</script>
