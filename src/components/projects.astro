---

interface Project {
  title: string;
  image: string;
  link: string;
  preview: string;
  status: string;
  tech: string[];
  description: string;
}

const projects: Project[] = [
  {
    title: "LankaDrive School Management System",
    image: "/projects/project1.png",
    link: "https://github.com/mhdhameed7/LankaDrive-Driving-School-Management-System",
    preview: "#",
    status: "Deployed",
    tech: ["React.js", "Electron", "Node.js", "SQLite"],
    description:
      "A desktop-based driving school management system to manage candidates, batches, admissions, instructors, vehicles, lessons, payments, and exams.",
  },
  {
    title: "DreamFrame – Photography Website",
    image: "/projects/project2.png",
    link: "https://github.com/mhdhameed7/DreamFrame-photography-system",
    preview: "#",
    status: "Deployed",
    tech: ["React.js", "GSAP", "ReactBits"],
    description:
      "A responsive full-stack photography website to showcase services, portfolios, and projects with modern UI, image galleries, and smooth interactions.",
  },
  {
    title: "Car Rental Management System",
    image: "/projects/project3.png",
    link: "https://github.com/mhdhameed7/car_rental",
    preview: "#",
    status: "Deployed",
    tech: ["PHP", "MySQL"],
    description:
      "A web-based car rental system to manage vehicles, bookings, and customers. Users can view available cars and make rental requests while admins handle records.",
  },
];
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2 shiny-sec">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {
        projects.map((project) => (
          <div class="group flex flex-col rounded-2xl border border-[#ffffff10] bg-[#0f0f0f] overflow-hidden hover:border-[var(--white-icon-tr)] transition-all duration-300">
            <a
              href={project.preview !== "#" ? project.preview : project.link}
              target="_blank"
              rel="noopener noreferrer"
              class="block"
            >
              <div class="overflow-hidden">
                <img
                  src={project.image}
                  alt={project.title}
                  class="w-full h-48 md:h-56 object-cover group-hover:scale-105 transition-transform duration-300"
                />
              </div>
            </a>

            <div class="flex flex-col flex-grow p-4 gap-3">
              <div class="flex items-start justify-between gap-2">
                <div class="flex-grow">
                  <h4 class="text-xl font-semibold leading-snug">{project.title}</h4>
                  <span class="text-xs text-[var(--sec)] font-medium mt-1 inline-block">{project.status}</span>
                </div>
                <div class="flex gap-2 flex-shrink-0">
                  <a
                    target="_blank"
                    href={project.link}
                    aria-label="GitHub"
                    class="size-10 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-2 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                      <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z" />
                    </svg>
                  </a>
                  {project.preview !== "#" && (
                    <a
                      target="_blank"
                      href={project.preview}
                      aria-label="Preview"
                      class="size-10 flex justify-center items-center text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-2 rounded-xl bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                        <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                      </svg>
                    </a>
                  )}
                </div>
              </div>

              {project.description && (
                <p class="text-sm text-[var(--white-icon)] leading-relaxed">
                  {project.description}
                </p>
              )}

              {project.tech.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-auto pt-2">
                  {project.tech.map((t) => (
                    <span class="text-xs px-3 py-1 rounded-full border border-[var(--white-icon-tr)] text-[var(--white-icon)] bg-[#ffffff08]">
                      {t}
                    </span>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
    <a
      target="_blank"
      href="https://github.com/mhdhameed7/"
      aria-label="GitHub"
      class="w-full flex items-center justify-center gap-2 mt-9 text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
    >
      <span class="md:text-lg text-md">More projects on</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="currentColor"
        class="size-6"
      >
        <path
          d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
        ></path>
      </svg>
    </a>
  </div>
</section>
