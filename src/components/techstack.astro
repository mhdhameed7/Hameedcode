<section id="techstack" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-10">
      <p class="text-xs tracking-[0.3em] uppercase text-[var(--white-icon)] mb-3 flex items-center justify-center gap-3">
        <span class="h-px w-10 bg-[var(--white-icon-tr)] inline-block"></span>
        My Skills &amp; Expertise
        <span class="h-px w-10 bg-[var(--white-icon-tr)] inline-block"></span>
      </p>
      <h2 class="text-4xl md:text-5xl font-bold">Tech <span class="text-[var(--sec)] shiny-sec">Stack</span></h2>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

      {[
        {
          category: "Frontend",
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
          skills: ["HTML", "CSS", "JavaScript", "React", "Bootstrap", "Kotlin", "PHP", "C#", "Electron"],
        },
        {
          category: "Backend",
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>`,
          skills: ["Node.js", "Express.js", "REST APIs", "JWT Authentication"],
        },
        {
          category: "Database",
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/></svg>`,
          skills: ["MySQL", "Prisma", "MongoDB", "SQLite", "Firebase"],
        },
        {
          category: "Tools",
          icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
          skills: ["Git", "GitHub", "VS Code", "XAMPP", "Postman", "Android Studio", "Visual Studio"],
        },
      ].map((group) => (
        <div class="group flex flex-col gap-4 p-5 rounded-2xl border border-[#ffffff10] bg-[#0a0a0a] hover:border-[var(--sec)] transition-all duration-300 hover:shadow-[0_0_24px_rgba(164,118,255,0.1)]">
          <!-- Category header -->
          <div class="flex items-center gap-3">
            <div class="p-2 rounded-xl bg-[#ffffff08] text-[var(--sec)] group-hover:bg-[var(--sec)] group-hover:text-black transition-all duration-300">
              <Fragment set:html={group.icon} />
            </div>
            <h3 class="text-base font-semibold text-[var(--white)]">{group.category}</h3>
          </div>

          <!-- Skills -->
          <div class="flex flex-wrap gap-2">
            {group.skills.map((skill) => (
              <span class="text-xs px-3 py-1.5 rounded-full border border-[#ffffff12] text-[var(--white-icon)] bg-[#ffffff06] hover:border-[var(--sec)] hover:text-[var(--white)] transition-all duration-200 cursor-default">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
